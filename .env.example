# ==============================================================================
# Muhammad Haroon Rashid Portfolio - Environment Variables Template
# ==============================================================================
# NOTE: Do NOT commit secrets or real webhook URLs to GitHub.
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Contact Form n8n Webhook URL
# Incoming POST payload: { name, email, message, timestamp, source }
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK=https://your-n8n-instance.com/webhook/portfolio-contact

# AI Assistant n8n Webhook URL
# Incoming POST payload: { message: string, history: Array<{ role: string, content: string }> }
# Outgoing response format: { success: boolean, answer: string }
# NOTE: Groq LLM credentials and API keys remain secured inside n8n.
NEXT_PUBLIC_N8N_CHAT_WEBHOOK=https://haroonrashid.duckdns.org/webhook/haroon-ai-assistant
